# Copy this file to .env.local for local development.
# Never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://lasmobility.com

# Microsoft Graph mail settings.
# The Azure app must have Application permission: Mail.Send
# and admin consent must be granted.
MICROSOFT_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_SECRET=replace-with-client-secret
MICROSOFT_GRAPH_FROM_EMAIL=support@lasmobility.com
